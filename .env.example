# --- База данни (Neon през Vercel Marketplace ги добавя автоматично) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# По желание – директна връзка без pooler, ползва се само за миграции
DATABASE_URL_UNPOOLED=

# --- Сесии на админ панела ---
# Дълъг случаен низ (напр. `openssl rand -base64 48`)
AUTH_SECRET=

# --- Cloudinary (Dashboard → Settings → API Keys) ---
CLOUDINARY_CLOUD_NAME=dk4bzhxfg
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Папка, в която панелът качва снимките
CLOUDINARY_FOLDER=barbaronite

# --- Имейл известия (resend.com) ---
RESEND_API_KEY=
# Подател. Преди да е верифициран домейнът barbaronite.eu в Resend, ползвайте onboarding@resend.dev
RESEND_FROM="БарбарониТЕ <onboarding@resend.dev>"

# --- Публичен адрес на сайта (за sitemap и линкове в имейлите) ---
NEXT_PUBLIC_SITE_URL=https://www.barbaronite.eu
